<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <UsingTask TaskName="SetBuildEnvironmentVariable"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <VariableName ParameterType="System.String" Required="true" />
      <VariableValue ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        System.Environment.SetEnvironmentVariable(VariableName, VariableValue);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="DisableAvaloniaBuildTelemetry" BeforeTargets="AvaloniaStats;PrepareForBuild">
    <SetBuildEnvironmentVariable VariableName="AVALONIA_TELEMETRY_OPTOUT" VariableValue="1" />
  </Target>

</Project>
