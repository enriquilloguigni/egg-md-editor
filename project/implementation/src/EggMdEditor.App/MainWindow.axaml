<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EggMdEditor.App.MainWindow"
        Title="egg-md-editor"
        Width="1280" Height="720">

  <!-- SC-001 (T-008–T-010): single window (BR-003) with the persistent menu
       bar (Z2) and the format bar (Z3) over the document area (Z4). The
       language entry with its mutually exclusive selection is built with the
       menu (T-010); the services wiring (COM-001–COM-004) arrives with
       T-011. -->
  <DockPanel>

    <!-- Z2 — Persistent menu bar, always visible: its menus and entries are
         built from MainMenuCatalog (single source of count and order,
         FR-011/DS-001) and remain visible with no connected action
         (ADR-001). -->
    <Menu x:Name="MenuBar" DockPanel.Dock="Top" />

    <!-- Z3 — Format bar, always visible: its controls are built from
         FormatBarCatalog (single source of count and order, FR-012/DS-001)
         in writing order, each one with its icon (VR-001) and its tooltip
         (VR-002), visible with no connected action (ADR-001). -->
    <StackPanel x:Name="FormatBar" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" />

    <!-- Z4 — Document area: empty in F-001, with no views or panels (FR-001
         → F-003, FR-004 → F-002); the format bar tooltips are painted over
         it. -->
    <Border x:Name="DocumentArea" />

  </DockPanel>

</Window>
