<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EggMdEditor.App"
        x:Class="EggMdEditor.App.MainWindow"
        x:DataType="app:MainWindowViewModel"
        Title="Egg MD Editor"
        Width="1280"
        Height="720">

  <Window.Styles>
    <!-- TK-004: tamaño y espaciado de los controles de la barra de formato. -->
    <Style Selector="Button.format-control">
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.format-control TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <!-- SC-001 (T-006, T-007, T-010): ventana única con menú principal
       persistente de los 6 menús de FR-011 y barra de formato con los
       controles de FR-012 en orden de escritura (ENT-005), visibles y sin
       acciones conectadas (ADR-001). T-010 declara la apertura/cierre del
       menú (TR-004/TR-005, COM-006) y el aviso flotante por control
       (TR-006/TR-007, COM-004); los manejadores solo actualizan el estado de
       sesión, sin acciones de dominio. -->
  <DockPanel>

    <Menu x:Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem x:Name="FileMenu"
                Header="{Binding FileMenuHeader}"
                Tag="Menu.File"
                Click="OnMenuEntryClick"
                SubmenuOpened="OnMenuSubmenuOpened" />
      <MenuItem x:Name="EditMenu"
                Header="{Binding EditMenuHeader}"
                Tag="Menu.Edit"
                Click="OnMenuEntryClick"
                SubmenuOpened="OnMenuSubmenuOpened" />
      <MenuItem x:Name="ViewMenu"
                Header="{Binding ViewMenuHeader}"
                Tag="Menu.View"
                Click="OnMenuEntryClick"
                SubmenuOpened="OnMenuSubmenuOpened" />
      <MenuItem x:Name="FormatMenu"
                Header="{Binding FormatMenuHeader}"
                Tag="Menu.Format"
                Click="OnMenuEntryClick"
                SubmenuOpened="OnMenuSubmenuOpened" />
      <MenuItem x:Name="ToolsMenu"
                Header="{Binding ToolsMenuHeader}"
                Tag="Menu.Tools"
                Click="OnMenuEntryClick"
                SubmenuOpened="OnMenuSubmenuOpened">
        <!-- OP-001 (T-008): selección de idioma mutuamente excluyente en
             Herramientas → Idioma de la interfaz; relabeliza en caliente sin
             reinicio y conserva ventana, menú y aviso (TR-002/TR-003). -->
        <MenuItem x:Name="LanguageMenu"
                  Header="{Binding LanguageMenuHeader}"
                  Tag="Menu.Tools.Language">
          <MenuItem x:Name="SpanishLanguageItem"
                    Header="{Binding SpanishOptionHeader}"
                    Tag="Language.es"
                    ToggleType="Radio"
                    GroupName="InterfaceLanguage"
                    IsChecked="{Binding IsSpanish, Mode=OneWay}"
                    Command="{Binding ChangeLanguageCommand}"
                    CommandParameter="es"
                    AutomationProperties.AutomationId="Language.es" />
          <MenuItem x:Name="EnglishLanguageItem"
                    Header="{Binding EnglishOptionHeader}"
                    Tag="Language.en"
                    ToggleType="Radio"
                    GroupName="InterfaceLanguage"
                    IsChecked="{Binding IsEnglish, Mode=OneWay}"
                    Command="{Binding ChangeLanguageCommand}"
                    CommandParameter="en"
                    AutomationProperties.AutomationId="Language.en" />
        </MenuItem>
      </MenuItem>
      <MenuItem x:Name="HelpMenu"
                Header="{Binding HelpMenuHeader}"
                Tag="Menu.Help"
                Click="OnMenuEntryClick"
                SubmenuOpened="OnMenuSubmenuOpened" />
    </Menu>

    <!-- Barra de formato (ENT-005): un icono (VR-001), un aviso flotante
         (VR-002) y un nombre accesible (NFR-009) por control, resueltos en
         el idioma activo. Ningún control tiene comando: su parte visual no
         está conectada a acciones en F-001 (ADR-001). -->
    <Border x:Name="FormatBarContainer"
            DockPanel.Dock="Top"
            Padding="8,5">
      <ItemsControl x:Name="FormatBar"
                    ItemsSource="{Binding FormatBarControls}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="app:FormatBarControlDefinition">
            <Button Classes="format-control"
                    Tag="{Binding Key}"
                    AutomationProperties.AutomationId="{Binding Key}"
                    AutomationProperties.Name="{Binding Name}"
                    ToolTip.Tip="{Binding Name}"
                    PointerEntered="OnFormatControlPointerEntered"
                    PointerExited="OnFormatControlPointerExited">
              <TextBlock Text="{Binding Glyph}" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Área de documento vacía en F-001 (BR-F001-008). -->
    <Border x:Name="DocumentArea" />

  </DockPanel>

</Window>
