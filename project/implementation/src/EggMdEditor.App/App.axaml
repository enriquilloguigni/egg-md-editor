<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="EggMdEditor.App.App"
             RequestedThemeVariant="Default">
    <!-- T-002/T-009 (ENT-003, OP-002): FluentTheme claro/oscuro. "Default"
         hereda el tema del SO; App.axaml.cs resuelve el tema efectivo al
         arrancar y la conmutación de la sesión lo fija después (COM-003). -->
    <Application.Styles>
        <FluentTheme />
        <!-- T-017 (VR-001, NFR-011): estilos de la librería de iconos
             Material.Icons.Avalonia 3.0.2 (MIT), que pinta cada icono como
             geometría vectorial en lugar de un glifo de texto. -->
        <materialIcons:MaterialIconStyles />
    </Application.Styles>

    <!-- T-014 (SC-002/SC-003): tokens de superficie de las nuevas pantallas.
         TK-001: roles semánticos claro/oscuro con contraste AA. TK-006:
         overlay y elevación del diálogo modal. Se resuelven con
         DynamicResource para que OP-002 repinte ambas superficies. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DialogOverlayBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DialogBorderBrush" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="DialogTextBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="DialogMutedBrush" Color="#5C5C5C" />
                    <SolidColorBrush x:Key="DialogErrorBrush" Color="#B3261E" />
                    <SolidColorBrush x:Key="DialogConfirmationBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="HelpNavigationBackgroundBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="HelpNavigationBorderBrush" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="HelpMutedTextBrush" Color="#5C5C5C" />
                    <SolidColorBrush x:Key="MenuSelectionBackgroundBrush" Color="#1976D2" />
                    <SolidColorBrush x:Key="MenuSelectionForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MenuPanelBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MenuPanelBorderBrush" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#212121" />
                    <SolidColorBrush x:Key="NoticeForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NoticeBorderBrush" Color="#000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DialogOverlayBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="DialogBorderBrush" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="DialogTextBrush" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="DialogMutedBrush" Color="#BDBDBD" />
                    <SolidColorBrush x:Key="DialogErrorBrush" Color="#FFB4AB" />
                    <SolidColorBrush x:Key="DialogConfirmationBrush" Color="#333333" />
                    <SolidColorBrush x:Key="HelpNavigationBackgroundBrush" Color="#242424" />
                    <SolidColorBrush x:Key="HelpNavigationBorderBrush" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="HelpMutedTextBrush" Color="#BDBDBD" />
                    <SolidColorBrush x:Key="MenuSelectionBackgroundBrush" Color="#64B5F6" />
                    <SolidColorBrush x:Key="MenuSelectionForegroundBrush" Color="#0B0B0B" />
                    <SolidColorBrush x:Key="MenuPanelBackgroundBrush" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="MenuPanelBorderBrush" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="NoticeForegroundBrush" Color="#0B0B0B" />
                    <SolidColorBrush x:Key="NoticeBorderBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
